rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // POS data — only authenticated staff can read/write
    match /stores/{storeId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Public website reads — products (menu/rooms), spaces (pricing), equipment, tabs (availability), stays (room occupancy)
    match /stores/{storeId}/slices/{sliceName} {
      allow read: if sliceName in ['products', 'spaces', 'equipment', 'tabs', 'stays'];
    }

    // Website bookings — anyone can submit or read (for order status tracking); only staff can update or delete
    match /website-orders/{orderId} {
      allow create, read: if true;
      allow update, delete: if request.auth != null;
    }

    // Venue-wide settings (including Gmail OAuth tokens) — authenticated staff only
    match /venue-settings/{docId} {
      allow read, write: if request.auth != null;
    }

    // Google Reviews cache — public read so website can display reviews client-side
    match /venue-settings/google-reviews {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Product images — stored separately so they don't bloat the products slice (1 MB Firestore limit)
    match /product-images/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Blog — public can read published posts/categories/tags; only authenticated staff can write
    match /blog-posts/{postId} {
      allow read: if resource.data.status == 'published';
      allow write: if request.auth != null;
    }
    match /blog-categories/{catId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blog-tags/{tagId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
