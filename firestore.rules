rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // POS data — only authenticated staff can read/write
    match /stores/{storeId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Public website reads — products (menu/rooms), spaces (pricing), equipment, tabs (availability), stays (room occupancy)
    match /stores/{storeId}/slices/{sliceName} {
      allow read: if sliceName in ['products', 'spaces', 'equipment', 'tabs', 'stays'];
    }

    // Website bookings — anyone can submit or read (for order status tracking); only staff can update or delete
    match /website-orders/{orderId} {
      allow create, read: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
